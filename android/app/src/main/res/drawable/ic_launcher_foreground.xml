<!-- The favicon.svg glyph (32×32) scaled ×1.5 into the 108dp adaptive-icon
     canvas: 32·1.5 = 48, centred by (108−48)/2 = 30. The glyph's own ink is
     centred inside its 32-unit box (see favicon.svg), so the drawn mark lands on
     the canvas centre and stays inside the 66dp safe zone every launcher mask
     respects — 39×31.5dp of ink, worst case a circle mask with 13dp to spare. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="1.5"
        android:scaleY="1.5"
        android:translateX="30"
        android:translateY="30">
        <path
            android:pathData="M4,7 L17,7 M4,13 L12,13"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M25,18 A5,5 0 1 1 15,18 A5,5 0 1 1 25,18"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
        <path
            android:pathData="M24,22 L27.5,25.5"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />
    </group>
</vector>
