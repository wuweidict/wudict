<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The server speaks HTTP on loopback; the WebView loads it from there.
         The app only ever talks to 127.0.0.1, so cleartext is allowed
         app-wide rather than via a networkSecurityConfig domain list. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Preparing a dictionary the user asked for is minutes of work in a
         process the platform otherwise reads as idle, and the freezer and the
         low-memory killer both act on that reading. FOREGROUND_SERVICE covers
         every level; the DATA_SYNC grant is required from API 34, where the
         service type is enforced rather than advisory. Neither is a runtime
         permission and neither is ever prompted for. See IndexService for why
         this - and not a priority boost - is the mechanism that helps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- From API 33 the service's own notification is posted only with this
         grant; without it the appop stays at `ignore` for the life of the
         install and every enqueue is dropped, which is what shipped: the
         service ran, protected the ingest, and said nothing. Declared here so
         it can be ASKED FOR, once, from the debounce of work that has already
         proved slow (Notif) - never at launch, and never again after the user
         answers. A denial changes nothing about the work. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Those four are everything this manifest declares. Three are
         install-time and cost the user no dialog; POST_NOTIFICATIONS is the
         app's only runtime permission and its only prompt (D62, amended).
         Every storage permission belongs to the `foss` flavour's manifest,
         because the `play` flavour has none: its dictionaries live in the
         app's own external files dir, which is permission-free on every API
         level. tools/verify-apk.sh asserts the set, so a fifth entry here
         fails the build until it is added there deliberately. -->

    <!-- Package visibility (API 30+), not a permission: without it the
         platform's TextToSpeech cannot see any installed engine and read-aloud
         reports no voices (Speech.java, D148). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Which apps are web browsers (API 30+ package visibility): wudict's
             own page of links has to be opened in one by package, because a
             plain VIEW of it resolves to this app's App Link (Intake.openInBrowser). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.WuWeiDict">

        <!-- Native libs use legacy packaging (see app/build.gradle): the
             server ships as jniLibs/<abi>/libwudict.so and must exist as a
             real file so it can be exec'd. allowBackup=false: the prepared
             library can be gigabytes and is rebuildable, so it must never go
             near Auto Backup. largeHeap: a big MDX collection is heavy. -->

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- An archive opened from a file manager. ARCHIVES ONLY, and
                 only the two this engine actually reads:

                 * .mdx/.ifo/.dsl/.slob/.bgl have no registered MIME type and
                   arrive as application/octet-stream, so a filter that caught
                   them would put WuWeiDict in the open-with sheet of every
                   unknown binary on the device. The Play flavour accepts those
                   through ACTION_SEND, where the user has already named us.
                 * application/gzip is NOT claimed: a .gz is not an archive
                   this engine opens, and claiming it means appearing for every
                   .tar.gz and .log.gz on the phone.
                 * zip and 7z ARE claimed, because both are read here and both
                   are what the dictionary sites hand out. The rule is that an
                   open-with entry must be able to finish the job it is offered
                   for; rar and tar are absent for exactly that reason.

                 No pathPattern: content:// URIs from DocumentsUI carry opaque
                 document ids, so a suffix match never fires, and the multi-dot
                 PatternMatcher behaviour makes it unreliable where it does. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
            </intent-filter>

            <!-- A DICTIONARY FILE opened from a file manager (D138). Separate
                 from the archive filter above because it is a different trade
                 and has to be readable as one.

                 None of .mdx/.mdd/.slob/.bgl/.zim/.ifo/.dsl has a registered
                 MIME type, and a content:// URI carries an opaque document id
                 rather than a file name - so there is no filter that matches
                 those extensions and nothing narrower than octet-stream to
                 claim. Claiming it means wuDict is listed for untyped files
                 IN GENERAL: a .bin, a firmware blob, a partial download. That
                 is the price of appearing for a .mdx at all, and it is paid
                 knowingly.

                 What is NOT paid is silence. Intake reads the provider's
                 display name on arrival - the first point at which this app
                 can see an extension - and declines anything it cannot read
                 by name (intake_unsupported), so being chosen for the wrong
                 file costs the user one sentence and nothing else.

                 application/gzip stays out: .dsl.dz and .dict.dz are real
                 main files, but claiming gzip means appearing for every
                 .tar.gz and .log.gz on the phone, and those arrive through
                 the share sheet where the user has already named us. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- wuDict's own share link: https://legbehindneck.com/wudict#<link>
                 opens here, whatever the link after "#" is - a dictionary, a
                 web folder of them, or a list (internal/intake/collection.go).
                 Unlike the hosts above this one is VERIFIED: the site serves
                 /.well-known/assetlinks.json naming this package and its
                 signing certificates, so on Android 12+ the link opens the app
                 with no setting to find. Exact paths, never a prefix: the rest
                 of the site is a website and must keep opening in the browser.
                 A filter of its own, because <data> elements in one filter
                 combine, and these paths would otherwise apply to the
                 distribution-site hosts in src/foss as well. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="legbehindneck.com" />
                <data android:path="/wudict" />
                <data android:path="/wudict/" />
            </intent-filter>

            <!-- Sharing an archive, from a browser's download list or a file
                 manager. In src/main because an archive is handled by the
                 flavour-neutral Intake, which needs no storage permission and
                 no picker grant - so the FOSS flavour, which has no intake of
                 any kind today, gains this. The Play manifest keeps the
                 octet-stream and gzip variants of these filters for its own
                 loose-file importer; the archive types belong to exactly one
                 handler. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
            </intent-filter>

            <!-- Long-press the launcher icon → Settings (D100). The meta-data
                 must sit on the MAIN/LAUNCHER activity: that is the one the
                 launcher reads shortcuts from. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Look up a selection made in another app (D67). One activity behind
             four ways in; a floating dialog, so it appears OVER the app the
             user is reading rather than replacing it. taskAffinity="" plus
             excludeFromRecents keeps it out of the app's own task and out of
             the recents list: it is an answer, not a place. All its filters
             live in src/main, so foss and play get them identically - nothing here
             touches storage. -->
        <activity
            android:name=".LookupActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/Theme.WuWeiDict.Lookup"
            android:windowSoftInputMode="adjustResize">

            <!-- The selection toolbar. android:label here overrides the
                 activity label for THIS filter only, so the toolbar reads
                 "Look up" while the share sheet below still reads
                 "WuWeiDict". -->
            <intent-filter android:label="@string/lookup_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share ⋯ - for apps that suppress the toolbar, and for
                 passages selected across several paragraphs. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- wudict://lookup?q=… - other apps and automation (Tasker,
                 Termux, note apps). The scheme is already the page→shell
                 private channel (Storage.handleShellUri, host "import"), and
                 the hosts do not collide: in-page wudict:// URLs are
                 intercepted by Shell.openExternal and never reach the system,
                 while this filter only ever sees other apps' intents. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:host="lookup" android:scheme="wudict" />
            </intent-filter>

            <!-- A reading app's own dictionary button. Every action below was
                 found in a reader that sends it WITHOUT naming a package, so
                 any app declaring the action is a candidate - the way GoldenDict
                 and Aard2 answer the first two. The word's extra, per action:

                 * colordict.intent.action.SEARCH  EXTRA_QUERY - "ColorDict 3":
                   Moon+ Reader, FBReader, KnownReader, Prestigio, Librera.
                 * aard2.lookup, aard2.search      query - KOReader, KnownReader.
                 * com.abbyy.mobile.lingvo.intent.action.TRANSLATE
                                                   com.abbyy.mobile.lingvo.intent.extra.TEXT
                                                   - Moon+ "Lingvo", FBReader "ABBYY Lingvo".
                 * com.ngc.fora.action.LOOKUP      HEADWORD - Moon+ "Fora".
                 * org.openintents.action.TRANSLATE EXTRA_TEXT - Prestigio "ABBYY".
                 * com.hughes.action.ACTION_SEARCH_DICT
                                                   query - KOReader "QuickDic".
                 * com.yunci.search                EXTRA_QUERY - Moon+ "YunCi".
                 * android.intent.action.SEARCH    query - listed as a dictionary
                   by Moon+ and Librera, sent by KOReader's "search" entries.
                 * android.intent.action.TRANSLATE EXTRA_TEXT - the platform's
                   own translate action (API 29).

                 The vendor-named ones (Lingvo, Fora, QuickDic, YunCi) are a
                 user decision recorded in the D67 amendment: the reader shows
                 that vendor's name, and with the vendor's app also installed
                 Android asks which one to use.

                 Twice: untyped, because every caller seen sends these without
                 a type, and text/plain, because a filter matches a typed intent
                 only if it names the type, and nothing stops a reader from
                 adding one. Not BROWSABLE: a web page has no business naming
                 any of them. -->
            <intent-filter>
                <action android:name="colordict.intent.action.SEARCH" />
                <action android:name="aard2.lookup" />
                <action android:name="aard2.search" />
                <action android:name="com.abbyy.mobile.lingvo.intent.action.TRANSLATE" />
                <action android:name="com.ngc.fora.action.LOOKUP" />
                <action android:name="org.openintents.action.TRANSLATE" />
                <action android:name="com.hughes.action.ACTION_SEARCH_DICT" />
                <action android:name="com.yunci.search" />
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="android.intent.action.TRANSLATE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="colordict.intent.action.SEARCH" />
                <action android:name="aard2.lookup" />
                <action android:name="aard2.search" />
                <action android:name="com.abbyy.mobile.lingvo.intent.action.TRANSLATE" />
                <action android:name="com.ngc.fora.action.LOOKUP" />
                <action android:name="org.openintents.action.TRANSLATE" />
                <action android:name="com.hughes.action.ACTION_SEARCH_DICT" />
                <action android:name="com.yunci.search" />
                <action android:name="android.intent.action.SEARCH" />
                <action android:name="android.intent.action.TRANSLATE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Dictan's external dispatcher: VIEW + this category, the word in
                 article.word, launched FOR A RESULT - CoolReader/KnownReader
                 and FBReader both send it without naming a package. The caller
                 reads the result code (LookupActivity.onCreate sets RESULT_OK;
                 CoolReader reports CANCELED as an error). No <data>, so a bare
                 VIEW with no URI also lands here - no app sends one, and one
                 that did would get "nothing to look up". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="info.softex.dictan.EXTERNAL_DISPATCHER" />
            </intent-filter>
        </activity>

        <!-- The shell's own settings (D100): Android-shell facts only - windows,
             intents, tasks - never a dictionary fact, which belongs to the page
             and the server (D54). Reached from the launcher shortcut, hence
             exported; it accepts no input, reads no extra and touches only its
             own preference file, so there is nothing for a caller to abuse.

             It reuses the popup's floating theme rather than declaring its own.
             That is not thrift: a normal window on targetSdk 36 inherits forced
             edge-to-edge, which Android 16 no longer lets an app opt out of, and
             would drag MainActivity's inset handling into a second file.
             Floating windows are exempt. taskAffinity="" plus excludeFromRecents
             keep it out of the app's task, exactly as the popup is kept out. -->
        <activity
            android:name=".SettingsActivity"
            android:configChanges="keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WuWeiDict.Lookup" />

        <!-- Holds the process up while a demanded ingest runs (IndexService).
             Not exported: it is started by this app's own shell, off the
             server's busy markers, and has nothing to say to anyone else. -->
        <service
            android:name=".IndexService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- No android:manageSpaceActivity (D63, amended 2026-09-07): declaring
             one REPLACES "Clear storage" in App Info rather than joining it, and
             a user who opens App Info is there to reclaim the whole folder in one
             gesture, not to prune a library dictionary by dictionary in a panel
             that was never a storage UI. Per-dictionary removal stays where it
             belongs, in the app; the platform's blunt instrument stays where the
             user already knows to find it. -->
    </application>
</manifest>