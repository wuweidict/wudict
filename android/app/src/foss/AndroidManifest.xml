<!-- The GitHub / F-Droid flavour (D62). Everything Play objects to lives
     here and nowhere else, so the `play` build cannot inherit it: the merger
     is additive, and no flavour ever removes another's node.

     D5 (user-approved): dictionaries are read from the shared "Dictionaries"
     folder. All-files access covers API 30+; the legacy pair covers 26–29
     (WRITE is granted at runtime on those). requestLegacyExternalStorage is
     the 29-and-below half of the same story, so it belongs here too. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <application android:requestLegacyExternalStorage="true">

        <!-- Sharing a LOOSE dictionary file to this app (D138). The archive
             types are claimed in src/main and handled by the flavour-neutral
             Intake; these are per-flavour because their HANDLER is: the Play
             flavour copies shared documents through SafImporter, which is its
             only way past the Storage Access Framework, while this flavour
             holds all-files access and can have the server read the file
             where it lies - which is also how the .mdd beside a shared .mdx
             comes along, since the server finds siblings by looking in the
             folder rather than by being handed them.

             Until now this flavour had no share target at all: the octet-
             stream filters lived only in src/play, and foss Storage.onNewIntent
             was an empty stub. So a .mdx could be opened here but not shared
             here, which is the gap this closes.

             application/gzip belongs here, unlike in the VIEW filter: a share
             is a file the user has already named this app for, so a .dsl.dz
             costs nothing to accept and a .tar.gz costs one sentence. -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/gzip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/gzip" />
            </intent-filter>

            <!-- Links to the sites that distribute these dictionaries (D139).
                 FOSS only: Play Console audits every http(s) host in the
                 manifest as a deep link and reports each one without
                 /.well-known/assetlinks.json as a failed domain check - and
                 these are third-party sites that will never serve one.
                 An ORDINARY browsable filter, with NO android:autoVerify: an
                 App Link would need /.well-known/assetlinks.json served from
                 those domains naming our package and signing certificate, and
                 we do not run them. Without it Android simply treats wuDict as
                 one more candidate for these URLs, which is all that is wanted
                 - the same shape AuroraStore uses for play.google.com links.

                 What that is worth depends on the Android version, and the
                 difference is worth knowing before this looks broken:

                 * Android 11 and below - wuDict joins the chooser, or can be
                   made the default handler for these hosts.
                 * Android 12 and above - an unapproved web filter gets
                   NOTHING; the link goes straight to the browser. The user
                   turns it on per-domain in Settings > Apps > wuDict > Open
                   by default > Add link. The filter is what makes that switch
                   exist at all, so it is still the price of admission.

                 Hosts, not paths: a forum thread and a download link are the
                 same URL shape on these sites, and pathPattern cannot tell
                 them apart (no backtracking, and a query string carries the
                 file). A tapped link that turns out to be a page is refused by
                 the server in a sentence - ErrNotArchive - which is the same
                 bargain the octet-stream VIEW filter in src/main makes. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="freemdict.com" />
                <data android:host="www.freemdict.com" />
                <data android:host="downloads.freemdict.com" />
                <data android:host="pkemb.com" />
                <data android:host="www.pkemb.com" />
                <data android:host="mdx.mdict.org" />
            </intent-filter>
        </activity>
    </application>
</manifest>
