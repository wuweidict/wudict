<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- TEMPLATE — not a usable plist; this block is stripped when it is rendered.

  `make mac-agent-install` fills @LABEL@ / @BIN@ / @LOGDIR@ and writes the result to
  ~/Library/LaunchAgents/@LABEL@.plist.

  It has to be generated: launchd expands nothing in ProgramArguments — no ~,
  no $HOME, no PATH lookup — so argv[0] must be a literal absolute path, which
  means a committed plist can only ever be correct on the machine that wrote it.
-->
<!-- Generated by `make mac-agent-install`. Edits here are overwritten; change the
     template in the repo (launchctl/*.plist.in) instead. -->
<plist version="1.0"><dict>
  <key>Label</key><string>@LABEL@</string>

  <key>ProgramArguments</key><array>
    <string>@BIN@</string>
    <string>serve</string>
    <string>--no-browser</string>
  </array>

  <key>RunAtLoad</key><true/>

  <!--
    Restart only after a FAILED exit. Plain <true/> also restarts after a clean
    one, which turns WuWeiDict's own handover (D23 — a second launch that finds
    the port already served by us exits 0 rather than erroring) into a restart
    loop: run wudict by hand while the agent is loaded and launchd would respawn
    the agent every 10s forever, each copy politely standing down.
  -->
  <key>KeepAlive</key><dict>
    <key>SuccessfulExit</key><false/>
  </dict>

  <!-- ~/Library/Logs, not /tmp: /tmp is periodically swept and shared with
       every other user on the machine. Console.app reads this location. -->
  <key>StandardOutPath</key><string>@LOGDIR@/wudict.log</string>
  <key>StandardErrorPath</key><string>@LOGDIR@/wudict.log</string>
</dict></plist>
