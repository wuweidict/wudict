#!TEMPLATE — not a usable unit; every #!TEMPLATE line is stripped on render.
#!
#! `make linux-service-install` fills @BIN@ and writes the result to
#! ${XDG_CONFIG_HOME:-~/.config}/systemd/user/wudict.service.
#!
#! This is a USER unit (systemctl --user), the analogue of the macOS
#! LaunchAgent: WuWeiDict reads ~/Dictionaries, writes ~/.wudict and binds
#! 127.0.0.1, so it wants the user's own $HOME and session — not root's.
#! Only installing the binary into @PREFIX@/bin needs sudo.
#!
#! Deliberately no After=/Wants=network-online.target: it binds loopback, and
#! network-online.target is not reliably present in the user manager anyway.
# Generated by `make linux-service-install`. Edits here are overwritten; change the
# template in the repo (systemd/wudict.service.in) instead.
[Unit]
Description=WuWeiDict dictionary server
Documentation=https://github.com/wuweidict/wudict

[Service]
Type=simple
ExecStart=@BIN@ serve --no-browser

# Restart only after a FAILED exit — the systemd equivalent of the LaunchAgent's
# KeepAlive/SuccessfulExit=false. `Restart=always` would fight WuWeiDict's own
# handover (D23): a second launch that finds the port already served by us exits
# 0 rather than erroring, so running wudict by hand while the unit is active
# would have systemd respawn it every few seconds, each copy standing down.
Restart=on-failure
RestartSec=5

NoNewPrivileges=true

# stdout/stderr go to the journal:  journalctl --user -u wudict -f
[Install]
WantedBy=default.target
